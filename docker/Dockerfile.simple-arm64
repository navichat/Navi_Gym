FROM ubuntu:22.04

RUN apt-get update && apt-get install -y python3 python3-pip
RUN pip3 install numpy torch --index-url https://download.pytorch.org/whl/cpu

WORKDIR /workspace
ENV PYTHONPATH=/workspace/navi-gym

CMD ["python3", "-c", "import platform; import torch; import numpy; print(f'Architecture: {platform.machine()}'); print('✅ Simple ARM64 test successful')"]